{
  "compilerOptions": {
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "target": "esnext",
    "module": "esnext",
    "types": [
      "node"
    ]
  },
  "include": [
    "*.ts",
    "*.mts",
    "tools"
  ]
}
