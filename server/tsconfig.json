{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "strict": true,
    "skipLibCheck": false,
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "build",
    "lib": [
      "esnext"
    ],
    "types": [
      "node"
    ],
    "moduleResolution": "nodenext",
    "paths": {
      "types": [
        "./types"
      ],
      "types/*": [
        "./types/*"
      ]
    }
  },
  "include": [
    "**/*"
  ],
  "exclude": [
    "node_modules/*"
  ]
}
