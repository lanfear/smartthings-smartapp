{
  "name": "smartthings-smartapp",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lanfear/smartthings-smartapp.git"
  },
  "description": "JavaScript/TypeScript library for using SmartThings APIs",
  "author": "Joseph M. Deming",
  "homepage": "https://github.com/lanfear/smartthings-smartapp",
  "bugs": "https://github.com/lanfear/smartthings-smartapp/issues",
  "dependencies": {
    "@smartthings/smartapp": "^4.3.8",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-ipfilter": "^1.4.0",
    "express-sse-ts": "^1.0.2",
    "http-status-codes": "^2.3.0",
    "json-diff-ts": "^4.10.4",
    "redis": "^6.3.0"
  },
  "devDependencies": {
    "@dotenv-run/esbuild": "^1.5.3",
    "@emotion/is-prop-valid": "^1.3.0",
    "@ngrok/ngrok": "^1.7.0",
    "@smartthings/core-sdk": "^8.5.4",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-prettier": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/triple-beam": "^1.3.5",
    "ace-builds": "^1.45.2",
    "concurrently": "^10.0.6",
    "cross-replace": "^0.2.0",
    "esbuild": "^0.23.1",
    "eslint": "^9.39.5",
    "eslint-config-techsmith": "^4.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-equals": "^6.2.1",
    "i18next": "^26.5.5",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-chained-backend": "^5.0.6",
    "i18next-http-backend": "^4.0.4",
    "i18next-localstorage-backend": "^4.3.2",
    "jiti": "^2.7.0",
    "local-web-server": "^5.4.2",
    "npm-watch": "^0.13.0",
    "react": "^19.3.1",
    "react-ace": "^15.0.0",
    "react-device-detect": "^2.2.3",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dnd-touch-backend": "^16.0.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.2",
    "react-router-dom": "^7.18.4",
    "replace-in-file": "^9.0.0",
    "styled-components": "^6.6.0",
    "swr": "^2.5.1",
    "typescript": "~6.0.3",
    "uplot": "^1.6.32",
    "usehooks-ts": "^3.1.1",
    "web-vitals": "^6.2.3",
    "zustand": "^5.0.16"
  },
  "scripts": {
    "start": "concurrently -i --default-input-target 2 -n \"server|tunnel,server|build,server|host,client|build,client|host,all|lint\" -c blue,gray,cyan,magenta,green,yellow \"npm:server-tunnel\" \"npm:server-build:watch\" \"npm:server-host:watch\" \"npm:client-build:watch\" \"npm:client-host:watch\" \"npm:lint:watch\"",
    "build": "concurrently -n \"server|build,client|build\" -c red,magenta \"npm:server-build\" \"npm:client-build\"",
    "deploy": "node tools/deploy.mts",
    "lint": "concurrently -n \"tools|tsc,client|tsc,server|tsc,all|eslint\" -c gray,cyan,blue,yellow \"npm:tools-lint:tsc\" \"npm:client-lint:tsc\" \"npm:server-lint:tsc\" \"npm:lint:eslint\"",
    "lint:eslint": "eslint --color --cache --cache-location node_modules/.cache/eslint/ .",
    "lint:fix": "npm run lint:eslint -- --fix",
    "lint:watch": "npm-watch lint",
    "kill-node-win": "taskkill -F -IM node.exe",
    "kill-node-linux": "killall .node.bin",
    "tools-lint:tsc": "tsc -p . --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/tools.tsbuildinfo",
    "client-start": "concurrently -n \"client|build,client|host\" -c magenta,green \"npm:client-build:watch\" \"npm:client-host:watch\"",
    "client-build": "node tools/bundle.ts",
    "client-build:watch": "npm-watch client-build",
    "client-host": "dotenv run -q -f client/.env -- cross-replace ws --directory client/build --port %SMARTAPP_WEBHARNESS_PORT% --spa index.html",
    "client-host:watch": "npm-watch client-host",
    "client-lint:tsc": "tsc -p client --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/client.tsbuildinfo",
    "client-kill": "dotenv run -q -f client/.env -- cross-replace node tools/killPort.ts %SMARTAPP_WEBHARNESS_PORT%",
    "server-start": "concurrently -n \"server|build,server|host\" -c gray,cyan \"npm:server-build:watch\" \"npm:server-host:watch\"",
    "server-build": "tsc -p server",
    "server-build:watch": "npm-watch server-build",
    "server-host": "node server/build/server.js",
    "server-host:watch": "npm-watch server-host",
    "server-prod": "npm run server-host",
    "server-tunnel": "dotenv run -q -f server/.env -- cross-replace ngrok http %STPORT% --log=stdout",
    "server-lint:tsc": "tsc -p server --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/server.tsbuildinfo",
    "server-kill": "dotenv run -q -f server/.env -- cross-replace node tools/killPort.ts %STPORT%"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "esbuild-reason": "because version of @dotenv-run/esbuild@1.4.0",
    "esbuild": "$esbuild"
  },
  "watch": {
    "lint": {
      "patterns": [
        "client/src",
        "server",
        "shared",
        "tools",
        "eslint.config.mts",
        "tsconfig.json",
        "client/tsconfig.json",
        "server/tsconfig.json"
      ],
      "ignore": [
        "server/build",
        "server/data"
      ],
      "extensions": "ts,tsx,mts,json",
      "delay": 1000,
      "runOnChangeOnly": false,
      "quiet": true
    },
    "client-host": {
      "patterns": [
        "client/.env",
        "package.json"
      ],
      "runOnChangeOnly": false,
      "quiet": true
    },
    "client-build": {
      "patterns": [
        "client/.env",
        "package.json",
        "client/public/index.html",
        "client/public/**/*.json",
        "client/src/**/*.ts",
        "client/src/**/*.tsx"
      ],
      "extensions": "html,json,ts,tsx",
      "runOnChangeOnly": false,
      "quiet": true
    },
    "server-build": {
      "patterns": [
        "server/**/*.ts",
        "server/**/*.tsx"
      ],
      "extensions": "ts,tsx",
      "runOnChangeOnly": false,
      "quiet": true
    },
    "server-host": {
      "patterns": [
        "server/build/server.js",
        "package.json",
        "server/.env",
        "server/.env.local"
      ],
      "extensions": "js",
      "runOnChangeOnly": false,
      "quiet": true
    }
  },
  "allowScripts": {
    "esbuild@0.23.1": true
  }
}
