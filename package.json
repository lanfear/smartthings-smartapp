{
  "name": "smartthings-smartapp",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lanfear/smartthings-smartapp.git"
  },
  "description": "JavaScript/TypeScript library for using SmartThings APIs",
  "author": "Joseph M. Deming",
  "homepage": "https://github.com/lanfear/smartthings-smartapp",
  "bugs": "https://github.com/lanfear/smartthings-smartapp/issues",
  "dependencies": {
    "@smartthings/file-context-store": "^0.0.1",
    "@smartthings/smartapp": "^4.3.6",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "express": "^4.17.1",
    "express-ipfilter": "^1.2.0",
    "express-rate-limit": "^6.9.0",
    "express-slow-down": "^1.6.0",
    "express-sse-ts": "^1.0.2",
    "helmet": "^5.0.2",
    "http-status-codes": "^2.1.4",
    "json-diff-ts": "^4.8.2",
    "redis": "^4.6.8"
  },
  "devDependencies": {
    "@dotenv-run/esbuild": "^1.4.0",
    "@emotion/is-prop-valid": "^1.3.0",
    "@ngrok/ngrok": "^1.7.0",
    "@smartthings/core-sdk": "^8.2.0",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-prettier": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^12.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/node": "^24.0.0",
    "@types/react": "^17.0.93",
    "@types/react-dom": "^17.0.26",
    "@types/triple-beam": "^1.3.2",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "ace-builds": "^1.36.0",
    "concurrently": "^9.2.1",
    "cross-replace": "^0.2.0",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.23.1",
    "eslint": "^9.39.2",
    "eslint-config-techsmith": "^4.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fast-equals": "^6.0.0",
    "i18next": "^23.14.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-chained-backend": "^4.6.2",
    "i18next-http-backend": "^2.6.1",
    "i18next-localstorage-backend": "^4.2.0",
    "jiti": "^2.6.1",
    "local-web-server": "^5.4.0",
    "npm-watch": "^0.13.0",
    "react": "^17.0.2",
    "react-ace": "^12.0.0",
    "react-device-detect": "^2.2.3",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dnd-touch-backend": "^16.0.1",
    "react-dom": "^17.0.2",
    "react-i18next": "^15.0.1",
    "react-router-dom": "^6.26.1",
    "react-sse-hooks": "^1.0.5",
    "replace-in-file": "^7.0.0",
    "styled-components": "^6.0.0",
    "swr": "^1.2.2",
    "typescript": "^5.5.4",
    "usehooks-ts": "^3.1.0",
    "web-vitals": "^4.2.3",
    "zustand": "^4.5.7"
  },
  "scripts": {
    "start": "concurrently -n server:tunnel,server:host,client:start -c blue,cyan,green \"npm:server-tunnel\" \"npm:server-start\" \"npm:client-start\"",
    "build": "concurrently -n server:build,client:build -c red,magenta \"npm:server-build\" \"npm:client-build\"",
    "lint": "concurrently -n tools:tsc,client:tsc,client:eslint,server:tsc,server:eslint -c gray,cyan,green,blue,magenta \"npm:tools-lint:tsc\" \"npm:client-lint:tsc\" \"npm:client-lint:eslint -- --cache\" \"npm:server-lint:tsc\" \"npm:server-lint:eslint -- --cache\"",
    "lint-fix": "concurrently -n client,server -c green,magenta \"npm:client-lint-fix\" \"npm:server-lint-fix\"",
    "kill-node-win": "taskkill -F -IM node.exe",
    "kill-node-linux": "killall .node.bin",
    "tools-lint:tsc": "tsc -p . --noEmit",
    "client-start": "npm-watch client-dev",
    "client-dev": "concurrently -c gray,white \"npm:client-dev:server\" \"npm:client-build:watch\"",
    "client-dev:server": "dotenv -e client/.env -- cross-replace ws --directory client/build --port %SMARTAPP_WEBHARNESS_PORT% --spa index.html",
    "client-build": "node tools/bundle.ts",
    "client-build:watch": "npm-watch client-build",
    "client-lint": "concurrently -n tsc,lint -c cyan,green \"npm:client-lint:tsc\" \"npm:client-lint:eslint -- --cache\"",
    "client-lint:tsc": "tsc -p client --noEmit",
    "client-lint:eslint": "eslint --color --cache-location node_modules/.cache/eslint/client \"client/src/**/*.{js,jsx,mjs,ts,tsx,mts}\"",
    "client-lint:watch": "npm-watch client-lint",
    "client-lint-fix": "npm run client-lint:eslint -- --cache --fix",
    "client-test": "react-app-rewired test",
    "client-kill": "dotenv -e client/.env -- cross-replace node tools/killPort.ts %SMARTAPP_WEBHARNESS_PORT%",
    "server-start": "concurrently -c gray,white \"npm:server-build:watch\" \"npm:server-prod:watch\"",
    "server-build": "tsc -p server",
    "server-build:watch": "npm-watch server-build",
    "server-prod": "node server/build/server.js",
    "server-prod:watch": "npm-watch server-prod",
    "server-tunnel": "dotenv -e server/.env -e server/.env-sample -- cross-replace ngrok http %STPORT% --log=stdout",
    "server-lint": "concurrently -n tsc,lint -c cyan,green \"npm:server-lint:tsc\" \"npm:server-lint:eslint -- --cache\"",
    "server-lint:tsc": "tsc -p server --noEmit",
    "server-lint:eslint": "eslint --color --cache-location node_modules/.cache/eslint/server server",
    "server-lint-fix": "npm run server-lint:eslint -- --cache --fix",
    "server-kill": "dotenv -e server/.env -- cross-replace node tools/killPort.ts %STPORT%"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "$@typescript-eslint/eslint-plugin",
    "esbuild-reason": "because version of @dotenv-run/esbuild@1.4.0",
    "esbuild": "$esbuild"
  },
  "watch": {
    "client-dev": {
      "patterns": [
        "client/.env",
        "package.json"
      ],
      "runOnChangeOnly": false,
      "quiet": true
    },
    "client-build": {
      "patterns": [
        "client/public/index.html",
        "client/public/**/*.json",
        "client/src/**/*.ts",
        "client/src/**/*.tsx"
      ],
      "extensions": "html,json,ts,tsx",
      "runOnChangeOnly": false,
      "quiet": true
    },
    "client-lint": {
      "patterns": [
        "client/src/**/*.ts",
        "client/src/**/*.tsx"
      ],
      "extensions": "ts,tsx",
      "runOnChangeOnly": false,
      "quiet": true
    },
    "server-build": {
      "patterns": [
        "server/**/*.ts",
        "server/**/*.tsx"
      ],
      "extensions": "ts,tsx",
      "runOnChangeOnly": false,
      "quiet": true
    },
    "server-prod": {
      "patterns": [
        "server/build/server.js",
        "package.json",
        "server/.env",
        "server/.env.local"
      ],
      "extensions": "js",
      "runOnChangeOnly": false,
      "quiet": true
    }
  },
  "allowScripts": {
    "esbuild@0.23.1": true
  }
}
